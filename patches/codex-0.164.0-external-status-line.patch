diff --git a/codex-rs/tui/src/external_status_line.rs b/codex-rs/tui/src/external_status_line.rs
new file mode 100644
index 0000000..1b1ce70
--- /dev/null
+++ b/codex-rs/tui/src/external_status_line.rs
@@ -0,0 +1,273 @@
+//! Bounded, cancellable external renderer for the persistent footer.
+//! One worker and one latest request per widget; no queued subprocesses or output logs.
+
+use std::path::PathBuf;
+use std::process::Stdio;
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant};
+
+use codex_protocol::ThreadId;
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+
+use crate::app_event::AppEvent;
+use crate::app_event_sender::AppEventSender;
+
+const TIMEOUT: Duration = Duration::from_secs(5);
+const REFRESH: Duration = Duration::from_secs(1);
+const UNCHANGED_REFRESH: Duration = Duration::from_secs(5);
+const IDLE_EXPIRY: Duration = Duration::from_secs(5);
+const MAX_OUTPUT: u64 = 32 * 1024;
+const MAX_ROWS: usize = 6;
+
+#[derive(Clone, Debug)]
+struct Request {
+    command: Vec<String>,
+    payload: String,
+    cwd: PathBuf,
+    thread_id: Option<ThreadId>,
+    width: u16,
+    updated: Instant,
+}
+
+#[derive(Debug)]
+pub(crate) struct ExternalStatusLineRunner {
+    latest: Arc<Mutex<Option<Request>>>,
+    task: Option<tokio::task::JoinHandle<()>>,
+    sender: AppEventSender,
+}
+
+impl ExternalStatusLineRunner {
+    pub(crate) fn new(sender: AppEventSender) -> Self {
+        Self {
+            latest: Arc::new(Mutex::new(None)),
+            task: None,
+            sender,
+        }
+    }
+
+    pub(crate) fn stop(&mut self) {
+        if let Some(task) = self.task.take() {
+            task.abort();
+        }
+        *self.latest.lock().expect("status renderer lock") = None;
+    }
+
+    pub(crate) fn request(
+        &mut self,
+        command: Vec<String>,
+        payload: String,
+        cwd: PathBuf,
+        thread_id: Option<ThreadId>,
+        width: u16,
+    ) {
+        *self.latest.lock().expect("status renderer lock") = Some(Request {
+            command,
+            payload,
+            cwd,
+            thread_id,
+            width,
+            updated: Instant::now(),
+        });
+        if self.task.as_ref().is_some_and(|task| !task.is_finished()) {
+            return;
+        }
+        let latest = Arc::clone(&self.latest);
+        let sender = self.sender.clone();
+        self.task = Some(tokio::spawn(async move {
+            let mut cached: Option<(Request, String, Instant)> = None;
+            loop {
+                let request = latest.lock().expect("status renderer lock").clone();
+                let Some(request) = request else { break };
+                // Parked threads stop polling; only the displayed widget refreshes this lease.
+                if request.updated.elapsed() > IDLE_EXPIRY {
+                    break;
+                }
+                let reusable = cached.as_ref().filter(|(previous, _, at)| {
+                    at.elapsed() < UNCHANGED_REFRESH
+                        && previous.command == request.command
+                        && previous.payload == request.payload
+                        && previous.cwd == request.cwd
+                        && previous.width == request.width
+                        && previous.thread_id == request.thread_id
+                });
+                let line = if let Some((_, output, _)) = reusable {
+                    Some(output.clone())
+                } else {
+                    let output = run_request(&request, TIMEOUT).await.ok();
+                    cached = output
+                        .as_ref()
+                        .map(|line| (request.clone(), line.clone(), Instant::now()));
+                    output
+                };
+                sender.send(AppEvent::ExternalStatusLineUpdated {
+                    thread_id: request.thread_id,
+                    line,
+                });
+                tokio::time::sleep(REFRESH).await;
+            }
+        }));
+    }
+}
+
+impl Drop for ExternalStatusLineRunner {
+    fn drop(&mut self) {
+        self.stop();
+    }
+}
+
+async fn run_request(request: &Request, timeout: Duration) -> Result<String, String> {
+    tokio::time::timeout(timeout, async {
+        let program = request.command.first().ok_or("empty renderer command")?;
+        let mut child = tokio::process::Command::new(program)
+            .args(&request.command[1..])
+            .current_dir(&request.cwd)
+            .env("CODEX_STATUS_LINE", "1")
+            .env("COLUMNS", request.width.to_string())
+            .kill_on_drop(true)
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::null())
+            .spawn()
+            .map_err(|e| e.to_string())?;
+        if let Some(mut input) = child.stdin.take() {
+            input
+                .write_all(request.payload.as_bytes())
+                .await
+                .map_err(|e| e.to_string())?;
+        }
+        let output = child.stdout.take().ok_or("missing renderer stdout")?;
+        let mut bytes = Vec::new();
+        output
+            .take(MAX_OUTPUT + 1)
+            .read_to_end(&mut bytes)
+            .await
+            .map_err(|e| e.to_string())?;
+        if bytes.len() as u64 > MAX_OUTPUT {
+            return Err("renderer output exceeds 32 KiB".to_string());
+        }
+        if !child.wait().await.map_err(|e| e.to_string())?.success() {
+            return Err("renderer exited unsuccessfully".to_string());
+        }
+        Ok(String::from_utf8_lossy(&bytes)
+            .lines()
+            .take(MAX_ROWS)
+            .collect::<Vec<_>>()
+            .join("\n"))
+    })
+    .await
+    .map_err(|_| "renderer timed out".to_string())?
+}
+
+#[cfg(all(test, unix))]
+mod tests {
+    use super::*;
+    fn request(script: &str) -> Request {
+        Request {
+            command: vec!["/bin/sh".into(), "-c".into(), script.into()],
+            payload: "one\ntwo\nthree\nfour\nfive\nsix\nseven\n".into(),
+            cwd: std::env::temp_dir(),
+            thread_id: None,
+            width: 77,
+            updated: Instant::now(),
+        }
+    }
+
+    #[tokio::test]
+    async fn external_status_output_and_row_count_are_bounded() {
+        assert_eq!(
+            run_request(&request("cat"), TIMEOUT).await.unwrap(),
+            "one\ntwo\nthree\nfour\nfive\nsix"
+        );
+        assert!(
+            run_request(&request("yes x | head -c 65536"), TIMEOUT)
+                .await
+                .is_err()
+        );
+        assert_eq!(
+            run_request(&request("printf '%s' \"$COLUMNS\""), TIMEOUT)
+                .await
+                .unwrap(),
+            "77"
+        );
+    }
+
+    #[tokio::test]
+    async fn external_status_timeout_and_failure_restore_native_fallback() {
+        assert!(
+            run_request(&request("exec sleep 30"), Duration::from_millis(50))
+                .await
+                .is_err()
+        );
+        assert!(run_request(&request("exit 1"), TIMEOUT).await.is_err());
+    }
+
+    #[tokio::test]
+    async fn external_status_coalesces_requests_and_stops_on_drop() {
+        let (tx, mut rx) = tokio::sync::mpsc::unbounded_channel();
+        let mut runner = ExternalStatusLineRunner::new(AppEventSender::new(tx));
+        for _ in 0..1000 {
+            runner.request(
+                vec![
+                    "/bin/sh".into(),
+                    "-c".into(),
+                    "cat >/dev/null; printf frame".into(),
+                ],
+                "{}".into(),
+                std::env::temp_dir(),
+                None,
+                80,
+            );
+        }
+        tokio::time::timeout(Duration::from_secs(2), rx.recv())
+            .await
+            .unwrap()
+            .unwrap();
+        assert!(rx.try_recv().is_err());
+        drop(runner);
+        assert!(
+            tokio::time::timeout(Duration::from_secs(2), rx.recv())
+                .await
+                .unwrap()
+                .is_none()
+        );
+    }
+
+    #[tokio::test]
+    async fn external_status_reuses_unchanged_frames_but_refreshes_new_payloads() {
+        let directory = tempfile::tempdir().unwrap();
+        let counter = directory.path().join("calls");
+        let script = format!(
+            "cat >/dev/null; printf run >> '{}'; printf frame",
+            counter.display()
+        );
+        let (tx, mut rx) = tokio::sync::mpsc::unbounded_channel();
+        let mut runner = ExternalStatusLineRunner::new(AppEventSender::new(tx));
+        let input = request(&script);
+        for _ in 0..3 {
+            runner.request(
+                input.command.clone(),
+                input.payload.clone(),
+                input.cwd.clone(),
+                None,
+                77,
+            );
+            tokio::time::timeout(Duration::from_secs(3), rx.recv())
+                .await
+                .unwrap()
+                .unwrap();
+        }
+        assert_eq!(std::fs::read_to_string(&counter).unwrap(), "run");
+        runner.request(
+            input.command.clone(),
+            "changed".into(),
+            input.cwd.clone(),
+            None,
+            77,
+        );
+        tokio::time::timeout(Duration::from_secs(3), rx.recv())
+            .await
+            .unwrap()
+            .unwrap();
+        assert_eq!(std::fs::read_to_string(&counter).unwrap(), "runrun");
+    }
+}
