+#[test]
+fn external_status_rows_grow_render_and_restore_native_fallback() {
+    let mut composer = composer();
+    let options = ComposerRenderOptions::default();
+    let original = composer.desired_height_with_options(80, options);
+    composer.set_external_status_lines(vec![
+        Line::from("AURORA 73%"),
+        Line::from("project"),
+        Line::from("effort high"),
+    ]);
+    assert_eq!(composer.status_surface_height(80, 8, options), 3);
+    assert!(composer.desired_height_with_options(80, options) > original);
+    let (text, cursor) = render(&composer, 80, None);
+    assert!(text.contains("AURORA 73%"));
+    assert!(text.contains("project"));
+    assert!(text.contains("effort high"));
+    assert!(cursor.is_some());
+    composer.set_external_status_lines(vec![Line::from("row"); 100]);
+    assert_eq!(composer.status_surface_height(80, 8, options), 6);
+    composer.set_external_status_lines(Vec::new());
+    assert_eq!(composer.status_surface_height(80, 8, options), 1);
+    let (text, _) = render(&composer, 80, None);
+    assert!(text.contains("MODEL"));
+}
+
+#[test]
+fn external_status_geometry_focus_width_and_native_restoration() {
+    use ratatui::style::Modifier;
+    let mut composer = composer();
+    composer.set_external_status_lines(
+        (1..=100)
+            .map(|i| Line::from(format!("external-{i}")))
+            .collect(),
+    );
+    assert_eq!(
+        composer
+            .footer
+            .external_status_lines
+            .as_ref()
+            .unwrap()
+            .len(),
+        6
+    );
+    for separate_status_line in [false, true] {
+        let options = ComposerRenderOptions {
+            separate_status_line,
+            max_height: Some(32),
+            ..Default::default()
+        };
+        let (_, rows) = render_status(&composer, Rect::new(0, 0, 80, 32), options);
+        assert_eq!(rows.len(), 6);
+        assert_eq!(rows[5], "external-6");
+    }
+    for unfocused in [false, true, false] {
+        let options = ComposerRenderOptions {
+            separate_status_line: true,
+            unfocused,
+            ..Default::default()
+        };
+        let area = Rect::new(0, 0, 40, 16);
+        let (buf, rows) = render_status(&composer, area, options);
+        assert_eq!(rows.len(), if unfocused { 1 } else { 6 });
+        if unfocused {
+            let status = inset_footer_hint_area(composer.layout_with_options(area, options).status);
+            assert!(buf[(status.x, status.y)].modifier.contains(Modifier::DIM));
+        }
+    }
+    composer.set_external_status_lines(vec![
+        Line::from("ABCDEFGHIJKLM"),
+        Line::from("界界界界界界"),
+    ]);
+    for width in [0, 1, 2, 3, 8, 12, 40, 8] {
+        let area = Rect::new(0, 0, width, 2);
+        let mut buf = Buffer::empty(area);
+        composer.render_status_surface(area, &mut buf, Default::default());
+        assert_eq!(
+            composer.status_surface_height(width, 2, Default::default()),
+            if width == 0 { 0 } else { 2 }
+        );
+        if width > 0 {
+            let inner = inset_footer_hint_area(area);
+            let text: String = (inner.x..inner.right())
+                .map(|x| buf[(x, 0)].symbol())
+                .collect();
+            let expected = crate::line_truncation::truncate_line_with_ellipsis_if_overflow(
+                Line::from("ABCDEFGHIJKLM"),
+                usize::from(inner.width),
+            );
+            assert_eq!(text.trim_end(), expected.to_string());
+        }
+    }
+    composer.set_status_line(Some("UPDATED native status".into()));
+    composer.set_external_status_lines(Vec::new());
+    assert!(
+        render(&composer, 80, None)
+            .0
+            .contains("UPDATED native status")
+    );
+    composer.set_status_line_enabled(false);
+    assert_eq!(composer.status_surface_height(80, 8, Default::default()), 0);
+}
