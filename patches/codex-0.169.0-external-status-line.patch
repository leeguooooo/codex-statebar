+#[test]
+fn external_status_preserves_input_cursor_and_find_in_short_terminals() {
+    let mut composer = composer();
+    composer.set_external_status_lines(vec![Line::from("external-row"); 6]);
+    composer.set_text_content("a\nb\nc".into(), Vec::new(), Vec::new());
+    composer.move_cursor_to_end();
+    for width in [12, 40] {
+        for height in [4, 5, 6, 8, 12, 32] {
+            let options = ComposerRenderOptions {
+                separate_status_line: true,
+                max_height: Some(height),
+                ..Default::default()
+            };
+            let area = Rect::new(0, 0, width, height);
+            let (buf, _) = render_status(&composer, area, options);
+            let layout = composer.layout_with_options(area, options);
+            assert!(layout.status.bottom() <= area.bottom());
+            assert!(layout.status.height <= 6);
+            assert!(layout.textarea.bottom() <= layout.status.y);
+            if height >= 8 {
+                assert!(layout.textarea.height >= 3);
+                let (x, y) = composer.cursor_pos_with_options(area, options).unwrap();
+                assert!(area.contains((x, y).into()));
+                assert!(buf.area.contains((x, y).into()));
+            }
+        }
+    }
+    composer.set_text_content(String::new(), Vec::new(), Vec::new());
+    let footer = TranscriptFooter {
+        text: vec![
+            Line::from("Find: needle"),
+            Line::from("Enter next · Esc close"),
+        ]
+        .into(),
+        cursor_column: Some(8),
+        is_interactive: true,
+    };
+    let options = ComposerRenderOptions {
+        separate_status_line: true,
+        footer: Some(&footer),
+        ..Default::default()
+    };
+    for (height, status_rows, hint_rows) in [(4, 0, 1), (5, 0, 2), (6, 1, 2)] {
+        let area = Rect::new(0, 0, 48, height);
+        let layout = composer.layout_with_options(area, options);
+        let mut buf = Buffer::empty(area);
+        composer.render_with_options(area, &mut buf, None, options);
+        assert_eq!(
+            (layout.status.height, layout.footer.height),
+            (status_rows, hint_rows)
+        );
+        assert_eq!(
+            composer.cursor_pos_with_options(area, options),
+            Some((10, layout.footer.y))
+        );
+    }
+}
