+    fn external_status_lines_grow_and_render_the_footer() {
+        let (tx, _rx) = unbounded_channel::<AppEvent>();
+        let sender = AppEventSender::new(tx);
+        let mut composer = ChatComposer::new(
+            /*has_input_focus*/ true,
+            sender,
+            /*enhanced_keys_supported*/ true,
+            "Ask Codex to do anything".to_string(),
+            /*disable_paste_burst*/ false,
+        );
+        composer.set_status_line_enabled(/*enabled*/ true);
+        composer.set_status_line(Some(Line::from("usage")));
+        let single_line_height = composer.desired_height(100);
+
+        composer.set_status_lines(vec![
+            Line::from("usage"),
+            Line::from("project"),
+            Line::from("mode"),
+        ]);
+        let multiline_height = composer.desired_height(100);
+        assert_eq!(multiline_height, single_line_height + 2);
+
+        let area = Rect::new(0, 0, 100, multiline_height);
+        let mut buf = Buffer::empty(area);
+        composer.render(area, &mut buf);
+        let row_text = |y| {
+            (0..area.width)
+                .map(|x| buf[(x, y)].symbol().chars().next().unwrap_or(' '))
+                .collect::<String>()
+        };
+        assert!(row_text(area.height - 3).contains("usage"));
+        assert!(row_text(area.height - 2).contains("project"));
+        assert!(row_text(area.height - 1).contains("mode"));
+    }
