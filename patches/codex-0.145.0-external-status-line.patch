+//! Async external-command backend for the footer status line.
+
+use std::path::PathBuf;
+use std::process::Stdio;
+use std::sync::{Arc, Mutex};
+use std::time::Duration;
+
+use codex_protocol::ThreadId;
+use tokio::io::AsyncWriteExt;
+
+use crate::app_event::AppEvent;
+use crate::app_event_sender::AppEventSender;
+
+// Python startup and the first cache fill can be slow on macOS. Execution is
+// fully asynchronous, so allow the cold render to complete; subsequent daemon
+// backed renders are normally near-instant.
+const STATUS_LINE_TIMEOUT: Duration = Duration::from_secs(15);
+
+#[derive(Debug, Default)]
+struct RunnerState {
+    in_flight: bool,
+    pending: bool,
+    latest: Option<Request>,
+}
+
+#[derive(Clone, Debug)]
+struct Request {
+    command: Vec<String>,
+    payload: String,
+    cwd: PathBuf,
+    thread_id: Option<ThreadId>,
+}
+
+#[derive(Clone, Debug)]
+pub(crate) struct ExternalStatusLineRunner {
+    state: Arc<Mutex<RunnerState>>,
+    app_event_tx: AppEventSender,
+}
+
+impl ExternalStatusLineRunner {
+    pub(crate) fn new(app_event_tx: AppEventSender) -> Self {
+        Self {
+            state: Arc::new(Mutex::new(RunnerState::default())),
+            app_event_tx,
+        }
+    }
+
+    /// Coalesces bursts: one process at a time, followed by at most one rerun
+    /// using the newest payload received while it was running.
+    pub(crate) fn request(
+        &self,
+        command: Vec<String>,
+        payload: String,
+        cwd: PathBuf,
+        thread_id: Option<ThreadId>,
+    ) {
+        let request = Request {
+            command,
+            payload,
+            cwd,
+            thread_id,
+        };
+        {
+            let mut state = self
+                .state
+                .lock()
+                .expect("external status line lock poisoned");
+            state.latest = Some(request);
+            if state.in_flight {
+                state.pending = true;
+                return;
+            }
+            state.in_flight = true;
+        }
+
+        let state = Arc::clone(&self.state);
+        let app_event_tx = self.app_event_tx.clone();
+        tokio::spawn(async move {
+            loop {
+                let request = {
+                    state
+                        .lock()
+                        .expect("external status line lock poisoned")
+                        .latest
+                        .clone()
+                };
+                let Some(request) = request else { break };
+
+                if let Ok(line) = run_request(&request).await {
+                    app_event_tx.send(AppEvent::ExternalStatusLineUpdated {
+                        thread_id: request.thread_id,
+                        line,
+                    });
+                }
+
+                let mut guard = state.lock().expect("external status line lock poisoned");
+                if guard.pending {
+                    guard.pending = false;
+                    continue;
+                }
+                guard.in_flight = false;
+                break;
+            }
+        });
+    }
+}
+
+async fn run_request(request: &Request) -> Result<String, String> {
+    let Some(program) = request.command.first() else {
+        return Err("external status line command is empty".to_string());
+    };
+    let mut command = tokio::process::Command::new(program);
+    command
+        .args(&request.command[1..])
+        .current_dir(&request.cwd)
+        .env("CODEX_STATUS_LINE", "1")
+        .kill_on_drop(true)
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped());
+
+    let mut child = command
+        .spawn()
+        .map_err(|error| format!("failed to spawn external status line: {error}"))?;
+    if let Some(mut stdin) = child.stdin.take() {
+        stdin
+            .write_all(request.payload.as_bytes())
+            .await
+            .map_err(|error| format!("failed to write external status line payload: {error}"))?;
+    }
+    let output = tokio::time::timeout(STATUS_LINE_TIMEOUT, child.wait_with_output())
+        .await
+        .map_err(|_| "external status line command timed out".to_string())?
+        .map_err(|error| format!("failed to read external status line output: {error}"))?;
+    if !output.status.success() {
+        return Err(format!(
+            "external status line command failed: {}",
+            String::from_utf8_lossy(&output.stderr).trim()
+        ));
+    }
+    Ok(String::from_utf8_lossy(&output.stdout)
+        .lines()
+        .next()
+        .unwrap_or_default()
+        .trim_end()
+        .to_string())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[cfg(unix)]
+    #[tokio::test]
+    async fn command_receives_json_and_only_first_stdout_line_is_used() {
+        let request = Request {
+            command: vec!["/bin/sh".into(), "-c".into(), "cat".into()],
+            payload: "first\nsecond\n".into(),
+            cwd: std::env::current_dir().expect("cwd"),
+            thread_id: None,
+        };
+        assert_eq!(run_request(&request).await, Ok("first".into()));
+    }
+}
